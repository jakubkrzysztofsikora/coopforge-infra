# --- model ---
# The manifest route with the widest tier coverage: everyday-fr-l40s,
# pro-fr-2x-l40s and everyday-96g all serve it (manifest/gateway.yaml).
MODEL_REPO=Qwen/Qwen3.6-35B-A3B-FP8
MODEL_SHA=95a723d08a9490559dae23d0cff1d9466213d989
# Model name the engine serves and litellm routes to. Compose cannot derive it
# from MODEL_REPO (no shell parameter expansion), so set it explicitly.
SERVED_MODEL_NAME=qwen3.6-35b-a3b
# 256K on pro-fr-2x-l40s; the single-GPU tiers serving this route cap at 128K.
# Raise only after measuring KV headroom on the deployed tier.
SERVED_CONTEXT=262144

# --- engine sizing ---
# Match to the tier's GPU count. Scaleway L40S/H100-SXM nodes expose N GPUs.
TP_SIZE=8
# 0.92 leaves ~8% for CUDA graphs + fragmentation; lower to 0.88 if startup OOMs.
GPU_MEM_UTIL=0.92
# Chunked prefill block size. Caps ITL jitter when an agent dumps a new file.
BATCHED_TOKENS=2048
# Max concurrent sequences per engine slot. DeepSeek tier is KV-cheap; dense tiers are not.
MAX_SEQS=16

# --- status push ---
COOPFORGE_STATUS_PUSH_URL=https://coopforge.eu/api/status-push
COOPFORGE_STATUS_TOKEN=change-me
# The coop's platform slug (coops.slug — slugify(title) plus a uniqueness
# suffix), NOT the tier id. /api/status-push resolves the coop by slug.
COOP_SLUG=change-me

# --- gateway + signer ---
# litellm master key; the signer uses it to mint per-coop virtual keys.
LITELLM_MASTER_KEY=change-me
# Bearer the engine requires. Same value on the gateway process.
VLLM_API_KEY=change-me
# Where the signer pushes tier status, and the shared secret it authenticates with.
COOPFORGE_API=https://coopforge.eu
COOPFORGE_API_KEY=change-me
